% ---- Walk-forward protocol: rolling origins, window choice, purging ---------
%
% CLAUDE.md 8.1-8.4 and Figure 1. Every element of the scheme resolves to one
% or more of these; docs/WALK_FORWARD_FOUNDATION.md is the element-by-element
% map, and it states which elements are grounded in the literature and which
% are this study's own design decisions.

@article{tashman2000outofsample,
  author  = {Tashman, Leonard J.},
  title   = {Out-of-sample tests of forecasting accuracy: an analysis and
             review},
  journal = {International Journal of Forecasting},
  volume  = {16},
  number  = {4},
  pages   = {437--450},
  year    = {2000},
  doi     = {10.1016/S0169-2070(00)00065-0},
  note    = {verified=doi-resolved, pdf=none. The canonical statement of
             ROLLING-ORIGIN evaluation and the source of the fixed-origin /
             rolling-origin and fixed-window / expanding-window vocabulary
             CLAUDE.md 8.1 uses. Grounds three separate choices: that a single
             train/test split is not an out-of-sample test at all, that
             accuracy must be averaged over multiple origins, and that
             rolling-origin errors are DEPENDENT -- which is why 9.2 clusters
             by origin instead of treating 90 cells as 90 draws.}
}

@article{bergmeir2018note,
  author  = {Bergmeir, Christoph and Hyndman, Rob J. and Koo, Bonsoo},
  title   = {A note on the validity of cross-validation for evaluating
             autoregressive time series prediction},
  journal = {Computational Statistics \& Data Analysis},
  volume  = {120},
  pages   = {70--83},
  year    = {2018},
  doi     = {10.1016/j.csda.2017.11.003},
  note    = {verified=doi-resolved, pdf=none. Cited AGAINST the easy version of
             our own argument: for a purely autoregressive model with
             uncorrelated errors, K-fold cross-validation is asymptotically
             valid and rolling-origin is merely wasteful. Citing it is what
             makes the walk-forward choice an argument rather than a reflex --
             its conditions fail here on two counts, because the model is
             cross-variate and because RQ2 makes TIME-SINCE-TRAINING the
             independent variable, which any non-chronological scheme
             destroys.}
}

